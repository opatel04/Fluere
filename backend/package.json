{
  "name": "tasksnap-backend",
  "version": "1.0.0",
  "description": "TaskSnap Backend API - AI-powered email to Trello integration",
  "main": "dist/index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "dev:worker": "nodemon --exec ts-node src/workers/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "migrate:gmail": "ts-node scripts/migrate-gmail-tokens.ts"
  },
  "keywords": [
    "trello",
    "gmail",
    "ai",
    "task-management",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.13.1",
    "bull": "^4.16.5",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "googleapis": "^164.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.7.5",
    "morgan": "^1.10.1",
    "nodemailer": "^7.0.10",
    "openai": "^6.6.0",
    "pg": "^8.16.3",
    "redis": "^5.8.3",
    "resend": "^6.3.0",
    "twilio": "^5.10.4",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mailparser": "^3.4.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.9.1",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
