# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/tasksnap
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tasksnap
DB_USER=postgres
DB_PASSWORD=your_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Gmail API Configuration
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:3000/api/v1/auth/gmail/callback

# Trello API Configuration
TRELLO_API_KEY=your_trello_api_key
TRELLO_API_SECRET=your_trello_api_secret
TRELLO_CALLBACK_URL=http://localhost:3000/api/v1/auth/trello/callback

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000

# Security
JWT_SECRET=your_jwt_secret_key
SESSION_SECRET=your_session_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=TaskSnap <noreply@tasksnap.com>
EMAIL_ENABLED=true

# Resend Configuration (for inbound email)
RESEND_API_KEY=re_your_resend_api_key
RESEND_INBOUND_DOMAIN=tasksnap.com

# App URL (for email links and dashboard)
APP_URL=http://localhost:3000

# Feature Flags (Freelancer Pivot)
ENABLE_DAILY_SUMMARY=true
ENABLE_FOLLOW_UP_DETECTION=true
ENABLE_SENTIMENT_ANALYSIS=true

# Timing Configurations
FOLLOW_UP_SCAN_INTERVAL_HOURS=6
DAILY_SUMMARY_TIME=08:00
WEEKLY_REPORT_DAY=monday
